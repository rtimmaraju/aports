# Maintainer:Ramya santoshi <rtimmaraju@qnx.com>
pkgname=dlt-daemon
pkgver=2.18.10
pkgrel=0
pkgdesc="Diagnostic Log and Trace (DLT) daemon"
url="https://github.com/COVESA/dlt-daemon"
arch="all"
license="MPL-2.0"
makedepends="cmake make libc++-dev zlib-dev qnx-io-sock-dev"
depends="libc++ qnx-io-sock"
source="
    dlt-daemon-${pkgver}.tar.gz::https://github.com/COVESA/dlt-daemon/archive/refs/tags/v${pkgver}.tar.gz
    dlt-daemon.patch
    gtest-1.13.0.tar.gz::https://github.com/google/googletest/archive/refs/tags/v1.13.0.tar.gz
"
builddir="$srcdir/dlt-daemon-$pkgver"
subpackages="$pkgname-dev"

build() {
    export CXXFLAGS="$CXXFLAGS -Qunused-arguments"
    export CFLAGS="$CFLAGS -Qunused-arguments"

    # ---------------------------------------------------------
    # Build GoogleTest 1.13.0 privately for DLT unit tests
    # ---------------------------------------------------------
    gtest_src="$srcdir/googletest-1.13.0"
    gtest_build="$builddir/third_party/gtest/build"
    gtest_install="$builddir/third_party/gtest/install"

    cmake -S "$gtest_src" \
        -B "$gtest_build" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=MinSizeRel \
        -DCMAKE_INSTALL_PREFIX="$gtest_install" \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -Dgtest_build_tests=OFF \
        -DBUILD_GMOCK=OFF

    cmake --build "$gtest_build"
    cmake --install "$gtest_build"

    # ---------------------------------------------------------
    # Build DLT-daemon with GoogleTest 1.13.0
    # ---------------------------------------------------------
    cmake -B build -S "$builddir" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWITH_SYSTEMD=OFF \
        -DWITH_DOC=OFF \
        -DWITH_MAN=OFF \
        -DWITH_DBUS=OFF \
        -DWITH_OFFLINE_LOGSTORAGE=OFF \
        -DWITH_DLT_QNX_SYSTEM=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DWITH_DLT_UNIT_TESTS=ON \
        -DWITH_DLT_CXX11_EXT=ON \
        -DCMAKE_PREFIX_PATH="$gtest_install" \
        -DGTest_DIR="$gtest_install/lib/cmake/GTest" \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5

    cmake --build build
}

#skipping gtest_dlt_daemon_gateway test as it require manaul setup

check() {
    cd "$builddir"
    ctest --test-dir build \
        --output-on-failure \
        -E "gtest_dlt_daemon_gateway"
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    # Remove private GoogleTest from the package if necessary
    rm -rf "$pkgdir/third_party"
}
