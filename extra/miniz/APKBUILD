# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>

pkgname=miniz
pkgver=3.1.2
pkgrel=0
pkgdesc="Single-file zlib replacement library"
url="https://github.com/richgel999/miniz"
arch="all"
license="MIT"

depends=""
makedepends="
cmake
ninja
"

source="
$pkgname-$pkgver.tar.gz::https://github.com/richgel999/miniz/archive/refs/tags/$pkgver.tar.gz
"

builddir="$srcdir/miniz-$pkgver"

build() {
    cmake -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
         -DBUILD_TESTS=ON \
        -DBUILD_EXAMPLES=ON \
        -DINSTALL_PROJECT=ON

    cmake --build build
}

check() {
    cd "$builddir"
    ./bin/catch_tests
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
SKIP
"